; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="卡师模拟器"
run/main_scene="res://LoadingScreen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://dp51awjvrf23i"

[audio]

audio/driver/output_latency=1

[autoload]

Global="*res://Global.gd"
SaveManager="*res://SaveManager.gd"
WarehouseManager="*res://WarehouseManager.gd"
CardManager="*res://CardManager.gd"
CircuitManager="*res://CircuitManager.gd"
PlayerManager="*res://PlayerManager.gd"
GuildTaskManager="*res://GuildTaskManager.gd"
TutorialManager="*res://TutorialManager.gd"
CardBridge="*res://CardBridge.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/initial_window_type=0

[editor_plugins]

enabled=PackedStringArray("res://addons/CardScanner/plugin.cfg", "res://addons/HJAds/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
